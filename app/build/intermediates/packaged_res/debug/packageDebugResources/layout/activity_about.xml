<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="24dp"
    android:background="@color/background">

    <ImageView
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_marginTop="32dp"
        android:src="@drawable/ic_airplane_logo"
        android:contentDescription="App Logo" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="SkyExcess Estimator v1.0"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/primary" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Developer Details"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/text_main" />

    <TextView
        android:id="@+id/tvDeveloperDetails"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:text="Name: MUHAMMAD ARIF RUSYAIDI BIN ROSLAN\nStudent ID: 2024420384\nGroup: RCDCS2405B\nProgramme: CDCS240 "
        android:textColor="@color/text_sub"
        android:textSize="14sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Application Source Code Website"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/text_main" />

    <TextView
        android:id="@+id/tvGithubUrl"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:autoLink="web"
        android:linksClickable="true"
        android:text="https://github.com/2024420384-wq/SkyExcess-Bag-Calculator.git"
        android:textColor="@color/accent"
        android:textSize="14sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="© 2026 ICT602 Mobile Technology. All Rights Reserved."
        android:textColor="@color/text_sub"
        android:textSize="12sp" />
</LinearLayout>
